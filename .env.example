# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# CONTACT FORM EMAIL DELIVERY (Nodemailer / SMTP)
# When configured, submissions to the contact form are dispatched directly to kelvinadado6@gmail.com
# Example for Gmail App Password or SMTP provider:
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-specific-password"
CONTACT_RECIPIENT="kelvinadado6@gmail.com"
CONTACT_EMAIL_FROM="One Adado Electricals Ventures <your-email@gmail.com>"
